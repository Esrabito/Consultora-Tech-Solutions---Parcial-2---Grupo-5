# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Clave para firmar las sesiones. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Contraseña de acceso al panel de administración
ADMIN_PASSWORD=cambiar-esta-contrasena

# Base de datos. Si no se define, se usa SQLite en instance/tech_solutions.db
# DATABASE_URL=sqlite:///tech_solutions.db

# 1 = modo desarrollo (recarga automática y detalle de errores). No usar en producción.
FLASK_DEBUG=1
